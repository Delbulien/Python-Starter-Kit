     ]
    }
   ],
   "source": [
    "nbpoint=10\n",
    "x=[]\n",
    "y=[]\n",
    "for i in range(nbpoint):\n",
    "    x.append(i)\n",
    "    val=myFunction(i)\n",
    "    y.append(val)\n",
    "\n",
    "print (\"x values : \",x)\n",
    "print (\"y values : \",y)"
   ]
